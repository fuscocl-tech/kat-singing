# Password for the teacher's CRM at /admin (required)
ADMIN_PASSWORD=change-me
# Random string used to sign login cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=
# Optional
STUDIO_NAME=Kat's Singing Studio
STUDIO_TIMEZONE=Australia/Sydney

# Local development needs ONE of these (see README):
# 1. Firestore emulator (test data only, nothing touches the live database)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# 2. The live database, using a service account key kept OUTSIDE this folder
# GOOGLE_APPLICATION_CREDENTIALS=/Users/you/.secrets/kat-singing-service-account.json
